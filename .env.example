# Copiar para .env e preencher com suas chaves
# NÃO commitar o arquivo .env (já está no .gitignore)

# Chave da Anthropic (obrigatória para usar Claude)
ANTHROPIC_API_KEY=sk-ant-SUA_CHAVE_AQUI

# Modelo padrão (pode sobrescrever com --model no comando)
TRANSLATE_MODEL=claude-haiku-4-5-20251001

# Idioma de saída padrão
LANG_OUT=pt

# Threads paralelas (aumentar para PDFs grandes)
THREADS=4
